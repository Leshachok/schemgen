{
  "name": "@uz/schemgen-renderer-vue",
  "version": "0.1.0",
  "description": "Vue 3 renderer for schemgen seat-layout schemes (trains and buses) - a port of schemgen-renderer-compose.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.0"
  }
}
